API_HOST=0.0.0.0
API_PORT=8001
APP_ENV=dev

DATABASE_URL=sqlite:///./data/workflow.db
CORS_ORIGINS=http://localhost:5173

OPENAI_API_KEY=
# 知识库入库向量化 / dense 检索路（可选）
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# MCP：使用 fastmcp.Client 连接远端；留空则 MCP 目录为空、Tool 节点执行会提示未配置
MCP_SERVER_URL=
# 兼容旧变量，与 MCP_SERVER_URL 二选一
MCP_BASE_URL=
MCP_MODE=mock
